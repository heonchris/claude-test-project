/*
 * 1단계 · FSR-402 포화 테스트
 *
 * 목적: 발로 체중을 실었을 때 센서값이 최대치에 붙어버려
 *       무게 이동을 구분하지 못하는지(=포화) 확인한다.
 *
 * 배선:
 *   5V  ── FSR 탭 ①
 *          FSR 탭 ② ──┬── A0
 *                      └── 10kΩ 저항 ── GND
 *
 * 확인 방법: [툴] → [시리얼 플로터]
 *
 * 통신 속도를 9600으로 둔 이유:
 *   아두이노 IDE 2.x의 기본값이 9600이라 아무것도 안 건드려도 바로 맞는다.
 *   IDE 버전에 따라 플로터의 속도 선택 상자가 안 보이거나 안 먹는 경우가
 *   있어서, 스케치를 IDE 기본값에 맞추는 편이 확실하다.
 *   1초 20회 × 5글자 = 초당 100글자 남짓이라 9600으로도 넉넉하다.
 *   (8채널을 30Hz로 보내는 3단계부터는 115200으로 올린다.)
 *
 * 값을 0~255로 줄이지 않고 0~1023 원본 그대로 출력한다.
 * 범위를 줄이면 포화 직전의 미세한 변화가 버려져 판정이 불가능해진다.
 */

const int FSR_PIN = A0;

void setup() {
  Serial.begin(9600);
}

void loop() {
  int raw = analogRead(FSR_PIN);
  Serial.println(raw);   // 숫자 하나만 출력해야 플로터가 그래프로 그린다
  delay(50);             // 1초에 20번 측정
}
