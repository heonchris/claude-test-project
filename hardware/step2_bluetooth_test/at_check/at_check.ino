/*
 * 2단계-A · 블루투스 모듈 확인 (AT 명령 통로)
 *
 * 목적: 모듈이 살아 있는지, 그리고 BLE 인지 클래식(SPP)인지 확인한다.
 *       이 구분이 결정적이다 — 클래식(HC-05/06)은 이 프로젝트의
 *       웹 앱과 연결할 수 없다.
 *
 * 하는 일: 시리얼 모니터에 친 글자를 그대로 모듈에 넘기고,
 *          모듈의 답을 그대로 시리얼 모니터에 돌려준다.
 *
 * 배선:
 *   모듈 VCC → 5V          (모듈에 3.3V 라고만 적혀 있으면 3.3V 로)
 *   모듈 GND → GND
 *   모듈 TXD → 아두이노 4번 핀
 *   모듈 RXD → 아두이노 5번 핀   ※ 아래 분압 주의
 *
 * ※ 0·1번 핀을 쓰지 않는 이유:
 *   0·1번은 USB 업로드가 쓰는 선이다. 거기 모듈을 꽂으면 업로드가
 *   실패하거나 값이 섞인다. 4·5번에 소프트웨어 시리얼로 따로 뺀다.
 *
 * ※ RXD 분압 (모듈을 지키는 장치):
 *   아두이노가 내보내는 신호는 5V 인데 모듈 입력은 3.3V 기준이다.
 *   5번 핀 ── 1kΩ ──┬── 모듈 RXD
 *                    └── 2kΩ ── GND
 *   브레이크아웃 보드 대부분은 견디지만, 분압을 넣으면 확실하다.
 *
 * 사용법:
 *   1. 업로드 후 시리얼 모니터 열기 (9600)
 *   2. 줄 끝 설정을 "Both NL & CR" 로  ← 안 하면 응답이 없다
 *   3. AT  입력 → OK 가 오면 모듈이 살아 있는 것
 *
 * ── 핀을 4·5번으로 쓰는 이유 ───────────────────────────
 * 처음에는 2·3번을 썼다. 그런데 실기기에서 아두이노 -> 모듈 방향만
 * 끝까지 동작하지 않았다. 배선 순서·통신 속도·모듈·앱을 모두 확인해
 * 정상임을 증명한 뒤에야, 핀을 4·5번으로 옮기자 바로 동작했다.
 * 즉 그 보드의 디지털 3번 핀이 죽어 있었다. 코드로는 찾을 수 없는
 * 고장이므로, 막히면 핀을 옮겨 보는 것을 점검 목록에 넣어 둔다.
 */

#include <SoftwareSerial.h>

SoftwareSerial bt(4, 5);   // RX=4(모듈 TXD), TX=5(모듈 RXD)

void setup() {
  Serial.begin(9600);
  bt.begin(9600);          // 응답이 없으면 38400, 115200 도 시도해 본다
  Serial.println(F("준비됨. 'AT' 를 입력하세요. (줄 끝 = Both NL & CR)"));
}

void loop() {
  if (bt.available())     Serial.write(bt.read());
  if (Serial.available()) bt.write(Serial.read());
}
